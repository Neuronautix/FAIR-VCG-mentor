# FAIR-VCG Mentor — backend configuration example.
# Copy to `.env` (project root or backend/) and edit. `env_loader` never
# overrides variables already set in the real environment.

# ── LLM provider ─────────────────────────────────────────────────────────────
# Choose the reasoning backend for all LLM-assisted features.
#   anthropic = Anthropic Claude (cloud)         [default]
#   openai    = any OpenAI-compatible endpoint (e.g. LM Studio serving a local
#               model such as Gemma or APERTUS) — keeps all data on-device.
LLM_PROVIDER=anthropic

# --- Provider: anthropic ---
# Required when LLM_PROVIDER=anthropic. Leave empty to run fully rule-based.
ANTHROPIC_API_KEY=
# Optional model override for the generic wrapper.
# HAIKU_MODEL=claude-haiku-4-5-20251001

# --- Provider: openai (local / LM Studio) ---
# Required when LLM_PROVIDER=openai.
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=google/gemma-3-27b-it
# LLM_API_KEY=lm-studio
# Truncate locally-extracted PDF text before sending to small-context models.
# LLM_MAX_DOC_CHARS=60000

# Per-feature model overrides work for both providers; when unset under the
# openai provider they fall back to LLM_MODEL.
# PAPER_EXTRACTION_MODEL=
# FAIR_SCORER_MODEL=
# COLUMN_ENRICHER_MODEL=
# ISSUE_FIXER_MODEL=
# VOCAB_DISCOVERY_MODEL=
# VCG_ORCHESTRATOR_MODEL=

# ── Online enrichment (off by default = fully local) ─────────────────────────
# Enables the CrossRef DOI lookup endpoint (/api/paper/doi). The only non-LLM
# outbound network call in the app. Leave disabled for an offline deployment.
ENABLE_ONLINE_ENRICHMENT=false

# ── Misc ─────────────────────────────────────────────────────────────────────
# SESSION_DB=sessions.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
