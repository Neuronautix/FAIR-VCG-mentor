# FAIR-VCG Mentor — LOCAL LLM configuration example.
# Copy to `.env` (project root or backend/) to run fully on-device against an
# OpenAI-compatible local server (LM Studio / Gemma / APERTUS). `env_loader`
# never overrides variables already set in the real environment.
#
#   cp backend/.env.local-llm.example backend/.env

# ── LLM provider: openai-compatible (local) ──────────────────────────────────
LLM_PROVIDER=openai

# LM Studio's default local server endpoint (OpenAI-compatible).
# When running the backend in Docker, use http://host.docker.internal:1234/v1
# (the docker-compose.local-llm.yml override sets this for you).
LLM_BASE_URL=http://localhost:1234/v1

# Model id as served by your local endpoint. Examples:
#   google/gemma-3-27b-it          (Gemma 3)
#   swiss-ai/apertus-8b-instruct   (APERTUS)
LLM_MODEL=google/gemma-3-27b-it

# LM Studio ignores the API key but the OpenAI client requires a non-empty one.
LLM_API_KEY=lm-studio

# Truncate locally-extracted PDF text before sending to small-context models.
LLM_MAX_DOC_CHARS=60000

# ── Online enrichment (off = fully local, no outbound calls) ─────────────────
ENABLE_ONLINE_ENRICHMENT=false

# ── Misc ─────────────────────────────────────────────────────────────────────
# SESSION_DB=sessions.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
